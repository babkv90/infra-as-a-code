# Local dev needs no override at all. The frontend defaults to the local backend at
# Frontend deployments use GitHub Environments.
# Set VITE_API_BASE_URL separately on each GitHub Environment:
# - development: dev API Gateway /api/v1 URL
# - test: test API Gateway /api/v1 URL
# - production: prod API Gateway /api/v1 URL
#
# Local dev can omit this; the app defaults to the local backend.
# VITE_API_BASE_URL=http://127.0.0.1:4001/api/v1
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
    

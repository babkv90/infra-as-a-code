# Local dev needs no override at all — this default relative path works via vite.config.ts's dev
# proxy (/api -> 127.0.0.1:4001). Production (the bundle deployed to CloudFront) needs an absolute
# URL instead, since there's no dev proxy in a static build — set that in .env.production, not here.
VITE_API_BASE_URL=/api/v1
VITE_AGENT_API_BASE_URL=http://127.0.0.1:4001/api/v1
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

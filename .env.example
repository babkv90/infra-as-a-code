# Local dev needs no override at all. The frontend defaults to the local backend at
# http://127.0.0.1:4001/api/v1 so DevTools shows API calls going to the backend port, not Vite's
# localhost:5173 dev server. Production builds should set an absolute API URL in .env.production.
# VITE_API_BASE_URL=http://127.0.0.1:4001/api/v1
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
    
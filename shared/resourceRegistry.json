{
  "schemaVersion": 1,
  "resources": {
    "alb": { "terraformType": "aws_lb", "required": ["subnets"], "recommended": ["name", "load_balancer_type", "internal", "security_groups"], "outputs": ["arn", "dns_name", "zone_id"], "edgeResolvable": { "subnets": "subnet" } },
    "apigw": { "terraformType": "aws_apigatewayv2_api", "required": ["protocol_type"], "recommended": ["name"], "outputs": ["id", "api_endpoint", "execution_arn"] },
    "beanstalk": { "terraformType": "aws_elastic_beanstalk_environment", "required": ["application", "solution_stack_name"], "recommended": ["name"], "outputs": ["id", "name", "endpoint_url", "cname"] },
    "cloudfront": { "terraformType": "aws_cloudfront_distribution", "required": ["enabled"], "recommended": ["comment", "default_root_object", "price_class"], "outputs": ["id", "arn", "domain_name", "hosted_zone_id"] },
    "cloudwatch": { "terraformType": "aws_cloudwatch_metric_alarm", "required": ["comparison_operator", "evaluation_periods", "metric_name", "namespace", "period", "statistic", "threshold"], "recommended": ["alarm_name"], "outputs": ["arn", "id"] },
    "codebuild": { "terraformType": "aws_codebuild_project", "required": ["service_role", "compute_type", "image", "type"], "recommended": ["name"], "outputs": ["arn", "id", "badge_url"] },
    "codepipeline": { "terraformType": "aws_codepipeline", "required": ["role_arn"], "recommended": ["name", "pipeline_type"], "outputs": ["arn", "id"] },
    "cognito": { "terraformType": "aws_cognito_user_pool", "required": [], "recommended": ["name", "mfa_configuration"], "outputs": ["arn", "id", "endpoint"] },
    "docdb": { "terraformType": "aws_docdb_cluster", "required": ["engine", "master_username", "master_password"], "recommended": ["cluster_identifier", "db_subnet_group_name", "vpc_security_group_ids"], "sensitive": ["master_password"], "outputs": ["arn", "endpoint", "reader_endpoint", "port"] },
    "docdb-instance": { "terraformType": "aws_docdb_cluster_instance", "required": ["cluster_identifier", "instance_class", "engine"], "recommended": ["identifier"], "outputs": ["arn", "endpoint", "identifier"], "edgeResolvable": { "cluster_identifier": "docdb" } },
    "docdb-subnet-group": { "terraformType": "aws_docdb_subnet_group", "required": ["subnet_ids"], "recommended": ["name"], "outputs": ["arn", "name"], "edgeResolvable": { "subnet_ids": "subnet" } },
    "dynamodb": { "terraformType": "aws_dynamodb_table", "required": ["billing_mode", "hash_key", "hash_key_type"], "recommended": ["name"], "outputs": ["arn", "id", "stream_arn"] },
    "ebs": { "terraformType": "aws_ebs_volume", "required": ["availability_zone", "size", "type"], "recommended": ["encrypted"], "outputs": ["id", "arn", "availability_zone"] },
    "ec2": { "terraformType": "aws_instance", "required": ["ami", "instance_type"], "recommended": ["subnet_id", "vpc_security_group_ids", "associate_public_ip_address", "iam_role_arn", "iam_instance_profile"], "outputs": ["id", "arn", "public_ip", "private_ip", "public_dns", "private_dns", "availability_zone", "key_pair_name", "ssh_private_key_pem"] },
    "ecr": { "terraformType": "aws_ecr_repository", "required": [], "recommended": ["name", "image_tag_mutability", "scan_on_push"], "outputs": ["arn", "repository_url", "registry_id"] },
    "ecs": { "terraformType": "aws_ecs_service", "required": [], "recommended": ["name", "cluster", "desired_count", "launch_type"], "outputs": ["id", "name", "cluster"] },
    "efs": { "terraformType": "aws_efs_file_system", "required": ["creation_token"], "recommended": ["encrypted", "performance_mode", "throughput_mode"], "outputs": ["id", "arn", "dns_name"] },
    "eks": { "terraformType": "aws_eks_cluster", "required": ["role_arn", "subnet_ids"], "recommended": ["name"], "outputs": ["arn", "endpoint", "certificate_authority", "identity"] },
    "elasticache": { "terraformType": "aws_elasticache_cluster", "required": ["engine", "node_type", "num_cache_nodes", "port"], "recommended": ["cluster_id"], "outputs": ["arn", "cache_nodes", "cluster_address"] },
    "eventbridge": { "terraformType": "aws_cloudwatch_event_rule", "required": [], "recommended": ["name"], "outputs": ["arn", "name"] },
    "iam": { "terraformType": "aws_iam_role", "required": ["assume_role_policy"], "recommended": ["name"], "outputs": ["arn", "name", "unique_id"], "edgeResolvable": { "assume_role_policy": "lambda" } },
    "igw": { "terraformType": "aws_internet_gateway", "required": ["vpc_id"], "outputs": ["id", "arn", "owner_id"], "edgeResolvable": { "vpc_id": "vpc" } },
    "kinesis": { "terraformType": "aws_kinesis_stream", "required": ["shard_count"], "recommended": ["name", "retention_period"], "outputs": ["arn", "name", "stream_mode_details"] },
    "kms": { "terraformType": "aws_kms_key", "required": ["description", "key_usage"], "recommended": ["deletion_window_in_days", "enable_key_rotation"], "outputs": ["arn", "key_id"] },
    "lambda": { "terraformType": "aws_lambda_function", "required": ["role_arn", "filename", "handler", "runtime"], "recommended": ["function_name", "source_code_hash", "memory_size", "timeout"], "outputs": ["arn", "invoke_arn", "function_name", "qualified_arn", "version"], "edgeResolvable": { "role_arn": "iam" } },
    "lb-listener": { "terraformType": "aws_lb_listener", "required": ["load_balancer_arn", "port", "protocol", "target_group_arn"], "outputs": ["arn", "id"], "edgeResolvable": { "load_balancer_arn": "alb", "target_group_arn": "lb-target-group" } },
    "lb-target-attachment": { "terraformType": "aws_lb_target_group_attachment", "required": ["target_group_arn", "target_id", "port"], "outputs": ["id"] },
    "lb-target-group": { "terraformType": "aws_lb_target_group", "required": ["port", "protocol", "vpc_id"], "recommended": ["name"], "outputs": ["arn", "name"], "edgeResolvable": { "vpc_id": "vpc" } },
    "nat": { "terraformType": "aws_nat_gateway", "required": ["subnet_id", "connectivity_type"], "outputs": ["id", "public_ip", "private_ip", "network_interface_id"] },
    "rds": { "terraformType": "aws_db_instance", "required": ["engine", "instance_class", "allocated_storage", "username", "password", "skip_final_snapshot"], "recommended": ["identifier"], "sensitive": ["password"], "outputs": ["arn", "address", "endpoint", "port", "resource_id"] },
    "redshift": { "terraformType": "aws_redshift_cluster", "required": ["node_type", "master_username", "master_password", "database_name"], "recommended": ["cluster_identifier"], "sensitive": ["master_password"], "outputs": ["arn", "endpoint", "dns_name"] },
    "route": { "terraformType": "aws_route", "required": ["route_table_id", "destination_cidr_block", "gateway_id"], "outputs": ["id"], "edgeResolvable": { "route_table_id": "route-table", "gateway_id": "igw" } },
    "route-association": { "terraformType": "aws_route_table_association", "required": ["subnet_id", "route_table_id"], "outputs": ["id"], "edgeResolvable": { "subnet_id": "subnet", "route_table_id": "route-table" } },
    "route-table": { "terraformType": "aws_route_table", "required": ["vpc_id"], "outputs": ["id", "arn", "owner_id"], "edgeResolvable": { "vpc_id": "vpc" } },
    "route53": { "terraformType": "aws_route53_record", "required": ["zone_id", "name", "type", "records"], "recommended": ["ttl"], "outputs": ["fqdn", "name"] },
    "s3": { "terraformType": "aws_s3_bucket", "required": ["bucket"], "recommended": ["bucket_prefix", "website_index_document", "website_error_document", "public_read", "versioning"], "outputs": ["id", "arn", "bucket_domain_name", "bucket_regional_domain_name"] },
    "secrets": { "terraformType": "aws_secretsmanager_secret", "required": [], "recommended": ["name", "description", "recovery_window_in_days"], "outputs": ["arn", "id", "name"] },
    "security-group": { "terraformType": "aws_security_group", "required": ["vpc_id"], "recommended": ["name", "ingress_ports", "ingress_cidr_blocks", "egress_cidr_blocks"], "outputs": ["id", "arn", "name", "owner_id"], "edgeResolvable": { "vpc_id": "vpc" } },
    "sns": { "terraformType": "aws_sns_topic", "required": [], "recommended": ["name", "display_name"], "outputs": ["arn", "id"] },
    "sqs": { "terraformType": "aws_sqs_queue", "required": ["fifo_queue"], "recommended": ["name", "visibility_timeout_seconds", "message_retention_seconds"], "outputs": ["arn", "id", "url"] },
    "subnet": { "terraformType": "aws_subnet", "required": ["vpc_id", "cidr_block", "availability_zone"], "recommended": ["map_public_ip_on_launch"], "outputs": ["id", "arn", "cidr_block", "availability_zone"], "edgeResolvable": { "vpc_id": "vpc" } },
    "vpc": { "terraformType": "aws_vpc", "required": ["cidr_block"], "recommended": ["enable_dns_hostnames", "enable_dns_support"], "outputs": ["id", "arn", "cidr_block", "default_security_group_id"] },
    "waf": { "terraformType": "aws_wafv2_web_acl", "required": ["scope", "default_action", "metric_name"], "recommended": ["name"], "outputs": ["arn", "id", "capacity"] },
    "xray": { "terraformType": "aws_xray_group", "required": ["group_name", "filter_expression"], "outputs": ["arn", "group_name"] }
  }
}

# services/agents local dev config. Copy to .env (gitignored) and fill in real values.

# Required. The Architect agent's LLM calls fail without this.
OPENAI_API_KEY=sk-replace-with-a-real-key
OPENAI_AGENT_MODEL=gpt-4o-mini

# Must exactly match IAAS backend/.env's AGENT_TOOL_SECRET — this service verifies the machine
# JWT Express mints per run, it never mints one itself.
AGENT_TOOL_SECRET=replace-with-a-long-random-agent-tool-secret

# The Express API's own base URL, used for every tool-gateway call (/internal/agent-tools/*).
EXPRESS_INTERNAL_URL=http://127.0.0.1:4001/api/v1

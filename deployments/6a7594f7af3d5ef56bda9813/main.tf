terraform {
  required_version = ">= 1.5.0"
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  backend "s3" {
    bucket         = "infraflow-terraform-state-897722687806"
    key            = "deployments/6a7594f7af3d5ef56bda9813/terraform.tfstate"
    region         = "ap-south-1"
    dynamodb_table = "infraflow-terraform-locks"
    encrypt        = true
  }
}

variable "lambda_source_code_hashes" {
  type    = map(string)
  default = {}
}

provider "aws" {
  region = "ap-south-1"
  default_tags {
    tags = {
      ManagedBy = "infraflow"
    }
  }
}

resource "aws_vpc" "starter_vpc" {
  cidr_block           = "10.20.0.0/16"
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name = "infraflow-starter-vpc-6a7594f7af3d5ef5"
  }
}

resource "aws_subnet" "public_subnet_a" {
  vpc_id                  = aws_vpc.starter_vpc.id
  cidr_block              = "10.20.1.0/24"
  availability_zone       = "ap-south-1a"
  map_public_ip_on_launch = true

  tags = {
    Name = "infraflow-public-subnet-a-6a7594f7af3d5ef5"
  }
}

resource "aws_internet_gateway" "internet_gateway" {
  vpc_id = aws_vpc.starter_vpc.id

  tags = {
    Name = "infraflow-internet-gateway-6a7594f7af3d5ef5"
  }
}

resource "aws_route_table" "public_route_table" {
  vpc_id = aws_vpc.starter_vpc.id

  tags = {
    Name = "infraflow-public-route-table-6a7594f7af3d5ef5"
  }
}

resource "aws_route" "internet_route" {
  route_table_id         = aws_route_table.public_route_table.id
  destination_cidr_block = "0.0.0.0/0"
  gateway_id             = aws_internet_gateway.internet_gateway.id
}

resource "aws_route_table_association" "public_route_association" {
  subnet_id      = aws_subnet.public_subnet_a.id
  route_table_id = aws_route_table.public_route_table.id
}

resource "aws_security_group" "web_security_group" {
  name        = "infraflow-web-security-group-6a7594f7af3d5ef5"
  description = "Allow SSH and HTTP to the starter EC2 instance"
  vpc_id      = aws_vpc.starter_vpc.id

  ingress {
    description = "Allow TCP 2280"
    from_port   = 2280
    to_port     = 2280
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "infraflow-web-security-group-6a7594f7af3d5ef5"
  }
}

output "infraflow_resource_outputs" {
  description = "Resource identifiers, ARNs, endpoints, and connectivity values generated by infraflow."
  value = {
    starter_vpc = {
      label = "Starter VPC"
      service = "VPC"
      service_id = "vpc"
      node_id = "tpl-starter-vpc"
      terraform_address = "aws_vpc.starter_vpc"
      id = try(aws_vpc.starter_vpc.id, null)
      arn = try(aws_vpc.starter_vpc.arn, null)
      cidr_block = try(aws_vpc.starter_vpc.cidr_block, null)
      default_security_group_id = try(aws_vpc.starter_vpc.default_security_group_id, null)
    }
    public_subnet_a = {
      label = "Public subnet A"
      service = "Subnet"
      service_id = "subnet"
      node_id = "tpl-starter-subnet"
      terraform_address = "aws_subnet.public_subnet_a"
      id = try(aws_subnet.public_subnet_a.id, null)
      arn = try(aws_subnet.public_subnet_a.arn, null)
      cidr_block = try(aws_subnet.public_subnet_a.cidr_block, null)
      availability_zone = try(aws_subnet.public_subnet_a.availability_zone, null)
    }
    internet_gateway = {
      label = "Internet gateway"
      service = "Internet Gateway"
      service_id = "igw"
      node_id = "tpl-starter-igw"
      terraform_address = "aws_internet_gateway.internet_gateway"
      id = try(aws_internet_gateway.internet_gateway.id, null)
      arn = try(aws_internet_gateway.internet_gateway.arn, null)
      owner_id = try(aws_internet_gateway.internet_gateway.owner_id, null)
    }
    public_route_table = {
      label = "Public route table"
      service = "Route Table"
      service_id = "route-table"
      node_id = "tpl-starter-rt"
      terraform_address = "aws_route_table.public_route_table"
      id = try(aws_route_table.public_route_table.id, null)
      arn = try(aws_route_table.public_route_table.arn, null)
      owner_id = try(aws_route_table.public_route_table.owner_id, null)
    }
    internet_route = {
      label = "Internet route"
      service = "Route"
      service_id = "route"
      node_id = "tpl-starter-route"
      terraform_address = "aws_route.internet_route"
      id = try(aws_route.internet_route.id, null)
    }
    public_route_association = {
      label = "Public route association"
      service = "Route Association"
      service_id = "route-association"
      node_id = "tpl-starter-route-assoc"
      terraform_address = "aws_route_table_association.public_route_association"
      id = try(aws_route_table_association.public_route_association.id, null)
    }
    web_security_group = {
      label = "Web security group"
      service = "Security Group"
      service_id = "security-group"
      node_id = "tpl-starter-sg"
      terraform_address = "aws_security_group.web_security_group"
      id = try(aws_security_group.web_security_group.id, null)
      arn = try(aws_security_group.web_security_group.arn, null)
      name = try(aws_security_group.web_security_group.name, null)
      owner_id = try(aws_security_group.web_security_group.owner_id, null)
    }
  }
}
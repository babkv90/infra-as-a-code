NODE_ENV=development
PORT=4001
# Local dev: point this at a local MongoDB instance, as below. In production (e.g. Lambda), set
# MONGODB_URI directly as an environment variable on the running service/function to your real
# connection string (e.g. a MongoDB Atlas mongodb+srv:// URI) — never commit a real URI/password
# here or in any .env* file; this file only ever holds placeholders.
MONGODB_URI=mongodb://127.0.0.1:27017/practicedevelopment
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated allowed frontend origins. CLIENT_ORIGINS is also accepted in production hosts.
CLIENT_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,https://infra-as-a-code.vercel.app,https://v72gcv51pi.execute-api.ap-south-1.amazonaws.com,https://d3pgg5abvvdatt.cloudfront.net
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Password reset email. Required in production for /auth/forgot-password.
APP_BASE_URL=https://your-frontend-domain.example
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-app-password
EMAIL_FROM="Infraflow <your-email@gmail.com>"

# Optional for local development. In production, prefer an ECS/EKS/EC2/host role.
# This identity must be allowed to call sts:AssumeRole into connected customer AWS accounts.
AWS_ACCESS_KEY_ID=your-base-access-key
AWS_SECRET_ACCESS_KEY=your-base-secret-key
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1

# Real deployment runner. Set true only when you are ready for Terraform to create AWS resources.
TERRAFORM_APPLY_ENABLED=true
TERRAFORM_BIN=terraform
TERRAFORM_WORK_DIR=

# Storage mode for uploaded artifacts (e.g. Lambda zips) and, once wired into the generator,
# Terraform state. 'local' (default) reads/writes IAAS backend/.terraform-runs on disk — nothing
# below this line is required. 's3' requires STORAGE_S3_BUCKET; the bucket and DynamoDB lock table
# must already exist (this app does not provision them). See STORAGE.md for how to test 's3' mode
# locally against a real bucket before deploying with it.
STORAGE_MODE=local
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_DYNAMODB_LOCK_TABLE=

# FastAPI RAG service created from wellarchitected-framework.pdf
RAG_API_URL=http://127.0.0.1:8000

# GitHub OAuth app for Vercel-style repository connection.
# Callback URL example: http://localhost:4001/api/v1/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=
GITHUB_TOKEN_ENCRYPTION_KEY=
